# Encrypts the settings and cloud login saved on the /auth page so they survive restarts.
# Generate once (openssl rand -hex 32) and keep it; keep this file out of git.
BAMBULAB_SECRET_KEY=

# Easiest setup: start the container with only the key above, then connect the printer at
# http://<docker-host>:9109/auth. Everything below is optional; /auth page settings win.

# Local (LAN) connection
# BAMBULAB_TRANSPORT=local_mqtt
# BAMBULAB_HOST=192.0.2.50
# BAMBULAB_SERIAL=01P00A000000000
# BAMBULAB_ACCESS_CODE=12345678
# BAMBULAB_PORT=8883
# BAMBULAB_USERNAME=bblp

# Bambu Cloud connection (set BAMBULAB_TRANSPORT=cloud_mqtt and BAMBULAB_SERIAL)
# BAMBULAB_CLOUD_EMAIL=you@example.com
# One-time emailed code for the env-variable login flow; remove after login
# BAMBULAB_CLOUD_CODE=123456
# Manually obtained tokens only
# BAMBULAB_CLOUD_USER_ID=1234567
# BAMBULAB_CLOUD_ACCESS_TOKEN=eyJ...
# BAMBULAB_CLOUD_REFRESH_TOKEN=
# BAMBULAB_CLOUD_MQTT_HOST=us.mqtt.bambulab.com
# BAMBULAB_CLOUD_MQTT_PORT=8883

# Config directory (mount it as a volume) and encrypted credentials file name
BAMBULAB_CONFIG_DIR=/config/bambulab-metrics-exporter
BAMBULAB_CREDENTIALS_FILE=credentials.enc.json

# Exporter behavior
BAMBULAB_REQUEST_PUSHALL=true
POLLING_INTERVAL_SECONDS=10
REQUEST_TIMEOUT_SECONDS=8

# HTTP server
LISTEN_HOST=0.0.0.0
LISTEN_PORT=9109
# Extra host names allowed for the /auth page (e.g. a reverse-proxy name), comma separated
AUTH_ALLOWED_HOSTS=

# Labels and logging
# PRINTER_NAME_LABEL=my-printer
LOG_LEVEL=INFO
